PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/bixi_dhiig
NODE_ENV=development
LOG_LEVEL=info

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

FRONTEND_URL=http://localhost:3000

# Google OAuth (web redirect flow + mobile idToken verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Resend (email). EMAIL_FROM must be on a domain verified in Resend,
# or use the sandbox sender: Bixi-Dhiig <onboarding@resend.dev>
RESEND_API_KEY=
EMAIL_FROM=Bixi-Dhiig <onboarding@resend.dev>

# WAHA (WhatsApp HTTP API)
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=default
# Only if you enabled an API key on your WAHA instance
WAHA_API_KEY=
